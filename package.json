{
  "name": "sufara",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "NODE_OPTIONS=--max-old-space-size=1024 vite --host --port 3000",
    "dev:api": "node server/index.mjs",
    "start": "node server/index.mjs",
    "db:migrate": "node scripts/db.mjs",
    "bridge": "node server/bridge.mjs",
    "build": "NODE_OPTIONS=--max-old-space-size=1024 vite build",
    "verify": "esbuild src/main.jsx --bundle --outdir=.kood-verify --loader:.jsx=jsx --loader:.css=empty --jsx=automatic --log-level=warning --log-limit=0",
    "preview": "vite preview",
    "test": "node --test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.546.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@tailwindcss/vite": "^4.3.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.1.0"
  },
  "optionalDependencies": {
    "pg": "^8.13.0"
  }
}