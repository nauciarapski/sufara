# Copy to .env and change what you need. Nothing here is a secret yet.
#
# The app's own API (server/index.mjs).
PORT=8787
# Where the collections are kept while there is no database. Point this at a mounted volume on a host that
# restarts.
DATA_DIR=server/.data

# A real database. Set this and the app stops using files: same API, same screens, same code - the rows are in
# Postgres. Run "npm run db:migrate" once afterwards (it creates the tables and records what it applied).
# DATABASE_URL=postgres://user:password@host:5432/database

# Client-side variables must start with VITE_ to reach the browser. Never put a secret here: anything with this
# prefix is compiled into the page that anyone can read.
# VITE_API_BASE=/api

# An integration that needs a client id and a secret (a provider's API, an OAuth2 client) belongs in
# server/routes/<name>.mjs: that file answers /api/<name>/* and reads its values from this one. The name goes
# here, the value goes in .env, and nothing secret ever reaches src/ or public/.
# PROVIDER_CLIENT_ID=
# PROVIDER_CLIENT_SECRET=

# The LAN bridge (server/bridge.mjs): the one process allowed to open a UDP socket or a TCP connection, because a
# browser cannot. Run it on a machine in the same network as the devices.
BRIDGE_PORT=8788
# Set a token before anything but this machine may use the bridge; the HMI sends it as x-bridge-token.
# BRIDGE_TOKEN=
# The origin the bridge answers (default *; set it to your HMI's address in anything but local use).
CONSOLE_ORIGIN=http://localhost:3000
